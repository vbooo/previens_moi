  "components": [
    {
      "name": "Bouton principal",
      "kind": "button",
      "refersTo": "button-primary-light",
      "description": "Action remplie Material 3 ; exemple de consultation en thème clair. Aperçu HTML consultatif ; référence Android native.",
      "html": "<button class=\"ds-primary\">Confirmer</button>",
      "css": ".ds-primary{font:500 14px/20px sans-serif;letter-spacing:.1px;cursor:pointer;background:#324C85;color:#FFFFFF;border:0;border-radius:999px;padding:8px 24px;min-height:48px}.ds-primary:hover{background-image:linear-gradient(#FFFFFF14,#FFFFFF14)}.ds-primary:active{background-image:linear-gradient(#FFFFFF29,#FFFFFF29)}.ds-primary:focus-visible{outline:2px solid #324C85;outline-offset:3px}.ds-primary:disabled{background:#1B1E271a;color:#1B1E2761;cursor:default}"
    },
    {
      "name": "Action textuelle",
      "kind": "button",
      "refersTo": "button-text-light",
      "description": "Action secondaire légère ; le rouge est réservé aux suppressions et erreurs. Aperçu HTML consultatif ; référence Android native.",
      "html": "<button class=\"ds-text\">Actualiser</button>",
      "css": ".ds-text{font:500 14px/20px sans-serif;letter-spacing:.1px;cursor:pointer;background:transparent;color:#324C85;border:0;border-radius:999px;padding:8px 12px;min-height:48px}.ds-text:hover{background:#324C8514}.ds-text:active{background:#324C8529}.ds-text:focus-visible{outline:2px solid #324C85;outline-offset:2px}"
    },
    {
      "name": "FAB étendu",
      "kind": "button",
      "refersTo": "fab-extended-light",
      "description": "Action unique de création sur l’accueil ; la profondeur native reste gérée par Material. Aperçu HTML consultatif ; référence Android native.",
      "html": "<button class=\"ds-fab\"><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 960 960\" fill=\"currentColor\"><path d=\"M440,520L200,520L200,440L440,440L440,200L520,200L520,440L760,440L760,520L520,520L520,760L440,760L440,520Z\"/></svg><span>Nouveau suivi</span></button>",
      "css": ".ds-fab{font:500 14px/20px sans-serif;letter-spacing:.1px;cursor:pointer;display:inline-flex;align-items:center;gap:12px;min-height:56px;padding:0 16px;background:#DCE4FF;color:#0B1B3C;border:0;border-radius:16px;box-shadow:0 4px 7px #00000029}.ds-fab:hover{background-image:linear-gradient(#0B1B3C14,#0B1B3C14)}.ds-fab:active{background-image:linear-gradient(#0B1B3C29,#0B1B3C29)}.ds-fab:focus-visible{outline:2px solid #324C85;outline-offset:3px}"
    },
    {
      "name": "Champ contour",
      "kind": "input",
      "refersTo": "field-outlined-light",
      "description": "Champ natif pleine largeur ; exemple monoligne, focus au clavier consultable. Aperçu HTML consultatif ; référence Android native.",
      "html": "<label class=\"ds-field\"><span>Zone concernée</span><input value=\"France\" aria-label=\"Zone concernée\" /></label>",
      "css": ".ds-field{display:block;position:relative;padding-top:7px;font:400 12px/16px sans-serif;color:#464B59}.ds-field>span{position:absolute;top:0;left:12px;padding:0 4px;background:#F5F6FA}.ds-field input{display:block;width:100%;min-height:56px;padding:12px 16px;border:1px solid #747986;border-radius:4px;background:#F5F6FA;color:#1B1E27;font:400 16px/24px sans-serif;box-sizing:border-box}.ds-field:hover input{border-color:#1B1E27}.ds-field:focus-within{color:#324C85}.ds-field input:focus-visible{outline:2px solid #324C85;outline-offset:-2px;border-color:#324C85}"
    },
    {
      "name": "Barre supérieure",
      "kind": "nav",
      "refersTo": "top-app-bar-light",
      "description": "TopAppBar native et retour sur un écran secondaire ; aucun menu inférieur V1. Aperçu HTML consultatif ; référence Android native.",
      "html": "<nav class=\"ds-topbar\" aria-label=\"Navigation\"><button aria-label=\"Retour\"><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 960 960\" fill=\"currentColor\"><path d=\"M313,520L537,744L480,800L160,480L480,160L537,216L313,440L800,440L800,520L313,520Z\"/></svg></button><span>Détail du suivi</span><button aria-label=\"Actions\"><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 960 960\" fill=\"currentColor\"><path d=\"M480,800Q447,800 423.5,776.5Q400,753 400,720Q400,687 423.5,663.5Q447,640 480,640Q513,640 536.5,663.5Q560,687 560,720Q560,753 536.5,776.5Q513,800 480,800ZM480,560Q447,560 423.5,536.5Q400,513 400,480Q400,447 423.5,423.5Q447,400 480,400Q513,400 536.5,423.5Q560,447 560,480Q560,513 536.5,536.5Q513,560 480,560ZM480,320Q447,320 423.5,296.5Q400,273 400,240Q400,207 423.5,183.5Q447,160 480,160Q513,160 536.5,183.5Q560,207 560,240Q560,273 536.5,296.5Q513,320 480,320Z\"/></svg></button></nav>",
      "css": ".ds-topbar{display:flex;align-items:center;gap:4px;min-height:64px;background:#F5F6FA;color:#1B1E27;font:400 22px/28px sans-serif}.ds-topbar>span{flex:1}.ds-topbar button{display:grid;place-items:center;width:48px;height:48px;border:0;border-radius:50%;background:transparent;color:#464B59;cursor:pointer}.ds-topbar button:hover{background:#464B5914}.ds-topbar button:active{background:#464B5929}.ds-topbar button:focus-visible{outline:2px solid #324C85}"
    },
    {
      "name": "Confirmation fixe",
      "kind": "button",
      "refersTo": "button-confirm-light",
      "description": "Button avec forme large et hauteur minimale. Aperçu HTML consultatif ; référence Android native.",
      "html": "<button class=\"ds-confirm\">Confirmer</button>",
      "css": ".ds-confirm{font:500 14px/20px sans-serif;letter-spacing:.1px;cursor:pointer;width:100%;min-height:52px;padding:8px 24px;background:#324C85;color:#FFFFFF;border:0;border-radius:16px}.ds-confirm:hover{background-image:linear-gradient(#ffffff14,#ffffff14)}.ds-confirm:active{background-image:linear-gradient(#ffffff29,#ffffff29)}.ds-confirm:focus-visible{outline:2px solid #324C85;outline-offset:3px}.ds-confirm:disabled{background:#1b1e271a;color:#464b5961;cursor:default}"
    },
    {
      "name": "Bouton tonal",
      "kind": "button",
      "refersTo": "button-tonal-light",
      "description": "FilledTonalButton pour pause ou annulation de préparation. Aperçu HTML consultatif ; référence Android native.",
      "html": "<button class=\"ds-tonal\"><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 960 960\" fill=\"currentColor\"><path d=\"M520,760L520,200L760,200L760,760L520,760ZM200,760L200,200L440,200L440,760L200,760ZM600,680L680,680L680,280L600,280L600,680ZM280,680L360,680L360,280L280,280L280,680ZM280,280L280,280L280,680L280,680L280,280ZM600,280L600,280L600,680L600,680L600,280Z\"/></svg><span>Mettre en pause</span></button>",
